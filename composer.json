{
    "name": "mortogo321/wordpress-admin-conflict-logger",
    "description": "WordPress plugin that logs JavaScript errors with plugin context to help identify admin conflicts",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload": {
        "classmap": ["."]
    },
    "scripts": {
        "lint": [
            "php -l admin-conflict-logger.php",
            "php -l includes/admin-page.php",
            "php -l uninstall.php",
            "phpcs"
        ],
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
